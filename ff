function showRowDealTooltip(e, dealNumber, rowType, tagCode, saleLeg) {
    const dn = String(dealNumber);
    if (rowType === 'PURCHASE') {
      // FIX BUG#1: prefer the ALLOCATED plan row matching the specific tag; fall back to the raw deal list
      const p = (STATE.planPurchaseDeals || []).find(x => String(x.deal_num) === dn && x.tag_code === tagCode)
             || STATE.purchaseDeals.find(x => String(x.deal_num) === dn);
      if (p) return showFlowTooltip(e, 'PurchaseDeal', p.id, p.location);
    } else if (rowType === 'SALE') {
      // FIX: Use tagCode and saleLeg to uniquely identify the sale deal, especially for PENDING ones
      const s = STATE.saleDeals.find(x => x.tag_code === tagCode && x.leg === saleLeg);
      if (s) return showFlowTooltip(e, 'SaleDeal', s.id, s.location);
    }
  }

