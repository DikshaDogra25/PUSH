        const volColor = isPur ? 'var(--orange)' : 'var(--green)';
        const v = Number(r.volume || 0);
        const vol = `<span style="color:${volColor}">${v > 0 ? '+' : ''}${v.toFixed(1)}</span>`;
        let trClass = blockClass + (i === 0 ? " block-start" : "");
        return `<tr class="${trClass}">
                  ${i === 0 ? leadCells : ""}
                  <td>${badge}</td>
                  <td style="font-family:var(--mono); font-weight:600; cursor:pointer; text-decoration:underline dotted var(--ink-dim); text-underline-offset:3px;"
                      onmousemove="showRowDealTooltip(event,'${r.deal_number}','${r.type}')" onmouseout="hideFlowTooltip()">${r.deal_number}</td>

