    @staticmethod
    def _resolve_cp(source, a_by_source, b_by_source):
        """Map a tag's ACTUAL source to the grouped CP it belongs to.
          1) exact CP hit wins (single-source groups: name == member),
          2) else find the group whose Source_Temp lists this source,
          3) else 'All' (the shared ruled-out pool).
        """
        src = DealSchedulePlan._clean(source)
        if src in a_by_source or src in b_by_source:
            return src
        for mapping in (a_by_source, b_by_source):
            for cp_key, entry in mapping.items():
                temp = (entry or {}).get("source_temp", "") or ""
                parts = [p.strip() for p in temp.split(",") if p.strip()]
                if src in parts:
                    return cp_key
        return "All"

    @staticmethod
    def _source_group_map(a_by_source, b_by_source):
        """From the grouped sale curves build:
          src_to_group: actual source -> group CP
          group_order:  group CP -> [member sources in Source_Temp order]
        """
        src_to_group: dict[str, str] = {}
        group_order: dict[str, list] = {}
        for mapping in (a_by_source, b_by_source):
            for cp_key, entry in mapping.items():
                temp = (entry or {}).get("source_temp", "") or ""
                parts = [p.strip() for p in temp.split(",") if p.strip()]
                if cp_key not in group_order:
                    group_order[cp_key] = parts if parts else [cp_key]
                for p in parts:
                    src_to_group.setdefault(p, cp_key)
                if not parts:
                    src_to_group.setdefault(cp_key, cp_key)
        return src_to_group, group_order

